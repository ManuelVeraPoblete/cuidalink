# Copiar a backend/.env para desarrollo local (ignorado por git).
# Spring lo importa automáticamente; en producción usar variables de entorno reales.

DB_URL=jdbc:postgresql://localhost:5432/cuidalink
DB_USERNAME=postgres
DB_PASSWORD=

# Generar con: openssl rand -base64 48
JWT_SECRET=

# En desarrollo Hibernate actualiza el esquema; en producción se deja el valor por defecto (validate).
JPA_DDL_AUTO=update

# Solo si un cliente web consume la API, p. ej. https://panel.cuidalink.cl
CORS_ALLOWED_ORIGINS=

FIREBASE_SERVICE_ACCOUNT_PATH=classpath:firebase-service-account.json
